---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const conditions = await getCollection("conditions");
const base = import.meta.env.BASE_URL;

const categoryLabels: Record<string, string> = {
  "rare-disease": "Rare disease",
  cancer: "Cancer",
  "chronic-autoimmune": "Chronic & autoimmune",
};

const categoriesPresent = [...new Set(conditions.map((c) => c.data.category))];

// Everything below is counted from the content itself, so the homepage can never
// claim more than the library actually holds.
const studyCount = conditions.reduce((total, c) => total + c.data.research.length, 0);
const treatmentCount = conditions.reduce((total, c) => total + c.data.treatments.length, 0);

// Symptom-first search: people often arrive knowing a symptom, not a diagnosis.
// These chips are pulled straight from the symptoms authors wrote in the JSON.
const suggestedSymptoms = [
  ...new Set(conditions.flatMap((c) => c.data.symptoms)),
].slice(0, 6);
---
<BaseLayout
  title="Home"
  description="Helios pairs plain-language overviews with peer-reviewed research, lifestyle guidance, and treatment information for people newly diagnosed with a medical condition."
>
  <div class="container">
    <section class="hero">
      <div class="hero__grid">
        <div>
          <span class="tag tag-accent-2">Newly diagnosed? Start here.</span>
          <h1 class="hero__title" style="margin-top: var(--space-4)">Understand your diagnosis, clearly.</h1>
          <p class="hero__lede">
            A plain-language overview paired with a peer-reviewed research library,
            lifestyle guidance, and treatment information — clearly sourced, never
            scraped from forums or anecdotes.
          </p>
          <div class="hero__actions">
            <a class="btn btn-primary" href="#find">Find a condition</a>
            <a class="btn btn-ghost" href={`${base}sourcing/`}>How we source</a>
          </div>
        </div>
        <div class="stat-cluster" aria-label="What the library holds right now">
          <div class="stat-bubble">
            <span class="stat-bubble__num">{conditions.length}</span>
            <span class="stat-bubble__label">condition {conditions.length === 1 ? "guide" : "guides"}</span>
          </div>
          <div class="stat-bubble stat-bubble--alt">
            <span class="stat-bubble__num">{studyCount}</span>
            <span class="stat-bubble__label">studies cited</span>
          </div>
          <div class="stat-bubble stat-bubble--alt">
            <span class="stat-bubble__num">{treatmentCount}</span>
            <span class="stat-bubble__label">treatments explained</span>
          </div>
          <div class="stat-bubble">
            <span class="stat-bubble__num">0</span>
            <span class="stat-bubble__label">forum anecdotes</span>
          </div>
        </div>
      </div>
    </section>

    <section id="find" class="finder" aria-labelledby="find-heading">
      <label class="finder__label" for="condition-search-input" id="find-heading">
        Search by condition — or by what you're actually experiencing
      </label>
      <input
        type="search"
        id="condition-search-input"
        class="input"
        placeholder="e.g. blood in urine, foamy urine, C3GN"
        autocomplete="off"
      />
      {suggestedSymptoms.length > 0 && (
        <div class="suggestions">
          <span class="suggestions__label">Try:</span>
          {suggestedSymptoms.map((symptom) => (
            <button type="button" class="suggestion" data-suggestion={symptom}>{symptom}</button>
          ))}
        </div>
      )}
      <div class="filters" role="group" aria-label="Filter by category">
        <button type="button" class="btn btn-ghost btn-sm category-filter" aria-pressed="true" data-category="all">
          All
        </button>
        {categoriesPresent.map((category) => (
          <button type="button" class="btn btn-ghost btn-sm category-filter" aria-pressed="false" data-category={category}>
            {categoryLabels[category]}
          </button>
        ))}
      </div>
      <p class="finder__count" id="condition-count" aria-live="polite"></p>
    </section>

    <div class="condition-grid" id="condition-grid">
      {conditions.map((condition) => (
        <a
          class="condition-card"
          href={`${base}conditions/${condition.id}/`}
          data-category={condition.data.category}
          data-search={[
            condition.data.name,
            condition.data.shortName,
            condition.data.summary,
            condition.data.alsoKnownAs.join(" "),
            condition.data.symptoms.join(" "),
          ]
            .join(" ")
            .toLowerCase()}
        >
          <div>
            <div class="condition-card__tags">
              <span class="tag tag-accent">{condition.data.shortName}</span>
              <span class={`tag tag--${condition.data.category}`}>
                {categoryLabels[condition.data.category]}
              </span>
            </div>
            <h2 class="condition-card__title">{condition.data.name}</h2>
            <p class="condition-card__summary">{condition.data.summary}</p>
            <span class="btn btn-primary">Read the guide</span>
          </div>
          <div class="condition-card__facts">
            <span class="condition-card__fact">
              <span>Studies cited</span><span>{condition.data.research.length}</span>
            </span>
            <span class="condition-card__fact">
              <span>Treatments</span><span>{condition.data.treatments.length}</span>
            </span>
            <span class="condition-card__fact">
              <span>Last reviewed</span><span>{condition.data.lastReviewed}</span>
            </span>
            <span class="condition-card__fact">
              <span>Next review</span><span>{condition.data.nextReviewDue}</span>
            </span>
          </div>
        </a>
      ))}
    </div>
    <p class="condition-grid-empty" id="condition-grid-empty" hidden>
      Nothing matches that yet — try a symptom instead of a diagnosis, or
      <a href={`${base}about/`}>tell us what's missing</a>.
    </p>

    <section class="band" style="margin-top: var(--space-8)">
      <h2 class="band__title">Every sentence traces back to a study, a guideline, or an institution.</h2>
      <p class="band__body">
        No forums, no anecdotes, no sponsored content. Each guide carries a review date, a
        next-review date, and a visible history of what changed — so you can see how current
        it is before you rely on it.
      </p>
      <p style="margin: var(--space-5) 0 0">
        <a class="btn btn-secondary" href={`${base}sourcing/`}>Read our sourcing standard</a>
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  const input = document.getElementById("condition-search-input") as HTMLInputElement | null;
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>(".category-filter"));
  const suggestions = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-suggestion]"));
  const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>(".condition-card"));
  const emptyMessage = document.getElementById("condition-grid-empty");
  const countMessage = document.getElementById("condition-count");
  let activeCategory = "all";

  function applyFilters() {
    const query = (input?.value || "").trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const matchesQuery = query === "" || (card.dataset.search || "").includes(query);
      const matchesCategory = activeCategory === "all" || card.dataset.category === activeCategory;
      const visible = matchesQuery && matchesCategory;
      card.style.display = visible ? "" : "none";
      if (visible) visibleCount += 1;
    });

    if (emptyMessage) emptyMessage.hidden = visibleCount !== 0;
    if (countMessage) {
      const noun = cards.length === 1 ? "condition" : "conditions";
      countMessage.textContent =
        visibleCount === cards.length
          ? `Showing all ${cards.length} ${noun}`
          : `Showing ${visibleCount} of ${cards.length} ${noun}`;
    }
  }

  input?.addEventListener("input", applyFilters);

  suggestions.forEach((chip) => {
    chip.addEventListener("click", () => {
      if (!input) return;
      input.value = chip.dataset.suggestion || "";
      input.focus();
      applyFilters();
    });
  });

  filters.forEach((button) => {
    button.addEventListener("click", () => {
      activeCategory = button.dataset.category || "all";
      filters.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      applyFilters();
    });
  });

  applyFilters();
</script>
