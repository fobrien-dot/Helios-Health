---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const pillars = [
  {
    title: "Global & free",
    description: "Accessible to anyone, anywhere, regardless of income or location.",
  },
  {
    title: "Informs, not replaces",
    description: "Built to support conversations with doctors — never to substitute for one.",
  },
  {
    title: "Clarity over jargon",
    description: "Complex research translated into language anyone can understand.",
  },
];

const boundaries = [
  "A replacement for a doctor, specialist, or care team",
  "A diagnostic tool",
  "A forum for unverified anecdotes or crowdsourced advice",
  "A source of medical, dietary, or treatment decisions made without a clinician",
];
---
<BaseLayout
  title="About"
  description="Helios is a single, trustworthy starting point for anyone who has just been told they have a medical condition — and a companion to care, not a replacement for it."
>
  <div class="container">
    <section class="hero">
      <p class="eyebrow">About Helios</p>
      <h1 class="hero__title">A single, trustworthy starting point.</h1>
      <p class="hero__lede">
        For anyone who has just been told they have a medical condition — pointing toward
        validated science, not noise.
      </p>
    </section>

    <section class="band band--accent">
      <h2 class="band__title">Why "Helios"?</h2>
      <p class="band__body">
        In Greek mythology, Helios was the Titan who drove the sun's chariot across the sky
        each day, bringing light after darkness. A new diagnosis can feel a lot like being
        left in the dark — overwhelming, disorienting, short on real answers. This platform
        borrows his name for the same reason he was worth naming after: not to dazzle, but to
        light the way — clear enough to see by, never blinding.
      </p>
    </section>

    <section class="section" id="vision" aria-labelledby="vision-heading">
      <p class="eyebrow">The vision</p>
      <h2 id="vision-heading">What Helios is for</h2>
      <div class="pillar-grid">
        {pillars.map((pillar) => (
          <article class="card">
            <h3>{pillar.title}</h3>
            <p>{pillar.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="boundaries" aria-labelledby="boundaries-heading">
      <p class="eyebrow">What this platform is not</p>
      <h2 id="boundaries-heading">A companion to care, not a substitute</h2>
      <p class="prose">
        Helios is meant to be brought to appointments, not to replace them — a way to ask
        better questions and understand the answers, grounded in validated science. It is not:
      </p>
      <ul class="marked-list marked-list--excluded prose">
        {boundaries.map((item) => <li>{item}</li>)}
      </ul>
      <p class="prose">
        Curious how we decide what counts as a trustworthy source? Read our
        <a href={`${base}sourcing/`}>sourcing standards</a>.
      </p>
    </section>
  </div>
</BaseLayout>
