---
interface StudyEntry {
  title: string;
  authors: string;
  journal: string;
  year: number;
  url: string;
  summary: string;
  sourceType: "peer-reviewed-journal" | "institution" | "advocacy-org";
}

interface Props {
  studies: StudyEntry[];
}

const { studies } = Astro.props;

const sourceTypeLabels: Record<StudyEntry["sourceType"], string> = {
  "peer-reviewed-journal": "Peer-reviewed journal",
  institution: "Recognized institution",
  "advocacy-org": "Patient-advocacy org",
};

const ordered = [...studies].sort((a, b) => a.year - b.year);
---
<section class="section" id="research" aria-labelledby="research-heading">
  <p class="eyebrow">The evidence</p>
  <h2 id="research-heading">Research library</h2>
  <p class="section__intro">
    Every study named, dated, and linked — summarized in plain language, in the order the
    field learned it.
  </p>
  {ordered.map((study) => (
    <article class="study">
      <div class="study__year" aria-hidden="true">{study.year}</div>
      <div>
        <h3>{study.title}</h3>
        <p class="card-meta">{study.journal} · {study.authors}</p>
        <p style="margin-top: var(--space-2)">{study.summary}</p>
        <span class="tag tag-outline">{sourceTypeLabels[study.sourceType]}</span>
        <a class="study__link" href={study.url} target="_blank" rel="noopener noreferrer">
          Read the study &#8599;
        </a>
      </div>
    </article>
  ))}
</section>
