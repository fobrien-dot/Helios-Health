---
interface Props {
  questions: string[];
  conditionName: string;
}

const { questions, conditionName } = Astro.props;
---
{questions.length > 0 && (
  <section class="section" id="questions" aria-labelledby="questions-heading">
    <p class="eyebrow">Bring this with you</p>
    <h2 id="questions-heading">Questions to ask your doctor</h2>
    <p class="section__intro">
      A starting point for your next appointment about {conditionName} — not a substitute
      for it. Print this page or pull it up on your phone.
    </p>
    <div class="questions-grid">
      {questions.map((question) => (
        <div class="question">
          <span class="question__mark" aria-hidden="true">?</span>
          <span>{question}</span>
        </div>
      ))}
    </div>
    <div class="appointment-actions no-print">
      <button type="button" class="btn btn-primary" onclick="window.print()">
        Print appointment sheet
      </button>
    </div>
  </section>
)}
