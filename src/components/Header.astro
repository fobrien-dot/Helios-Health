---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const links = [
  { href: base, label: "Conditions", match: (p: string) => p === base || p === base.slice(0, -1) },
  { href: `${base}sourcing/`, label: "How we source", match: (p: string) => p.includes("/sourcing") },
  { href: `${base}about/`, label: "About", match: (p: string) => p.includes("/about") },
];
---
<header class="site-header">
  <div class="container site-header__row">
    <a class="site-header__brand" href={base}>
      <span class="site-header__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <path class="site-header__corona" d="M27.5,16 Q30.78,22.12 24.13,24.13 Q22.12,30.78 16,27.5 Q9.88,30.78 7.87,24.13 Q1.22,22.12 4.5,16 Q1.22,9.88 7.87,7.87 Q9.88,1.22 16,4.5 Q22.12,1.22 24.13,7.87 Q30.78,9.88 27.5,16 Z" fill="var(--sun-outer)" />
          <circle cx="16" cy="16" r="9.2" fill="var(--sun-mid)" />
          <circle cx="16" cy="16" r="4.8" fill="var(--sun-core)" />
        </svg>
      </span>
      <span class="site-header__name">Helios</span>
    </a>
    <nav class="site-header__nav" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href} aria-current={link.match(path) ? "page" : undefined}>{link.label}</a>
      ))}
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-pressed="false"
        aria-label="Switch between light and dark mode"
      >
        <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <span class="theme-toggle__text">Dark</span>
      </button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("theme-toggle");
  const label = toggle?.querySelector(".theme-toggle__text");

  function sync() {
    const isDark = document.documentElement.dataset.theme === "dark";
    toggle?.setAttribute("aria-pressed", String(isDark));
    if (label) label.textContent = isDark ? "Light" : "Dark";
  }

  toggle?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("helios-theme", next);
    } catch (e) {
      /* storage unavailable — the choice just won't persist */
    }
    sync();
  });

  sync();
</script>
