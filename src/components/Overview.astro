---
interface Props {
  whatIsIt: string;
  keyPoints: string[];
}

const { whatIsIt, keyPoints } = Astro.props;
---
<section class="section" id="overview" aria-labelledby="overview-heading">
  <p class="eyebrow">Start here</p>
  <h2 id="overview-heading">What this actually is</h2>
  <p class="prose" style="font-size: 1.1rem">{whatIsIt}</p>
  <div class="keypoint-grid">
    {keyPoints.map((point, index) => (
      <div class="keypoint">
        <span class="keypoint__num" aria-hidden="true">{index + 1}</span>
        <p>{point}</p>
      </div>
    ))}
  </div>
</section>
