---
interface LifestyleEntry {
  title: string;
  guidance: string;
}

interface Props {
  entries: LifestyleEntry[];
}

const { entries } = Astro.props;
---
<section class="section" id="lifestyle" aria-labelledby="lifestyle-heading">
  <p class="eyebrow">Day to day</p>
  <h2 id="lifestyle-heading">Living with it</h2>
  <p class="section__intro">
    Everyday habits worth discussing with your care team — general guidance, not a plan
    written for you.
  </p>
  <div class="lifestyle-grid">
    {entries.map((entry) => (
      <article class="card">
        <p class="card-kicker">{entry.title}</p>
        <p>{entry.guidance}</p>
      </article>
    ))}
  </div>
</section>
