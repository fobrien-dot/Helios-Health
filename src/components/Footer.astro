---
const base = import.meta.env.BASE_URL;
const pagePath = Astro.url.pathname.replace(base, "/");
const editIssueUrl = `https://github.com/fobrien-dot/Helios-Health/issues/new?${new URLSearchParams(
  {
    title: `Suggested edit: ${pagePath}`,
    body: `Page: ${pagePath}\n\nWhat should change, and why (include a source if you have one):\n`,
    labels: "content",
  }
)}`;
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <p class="site-footer__note">
        Helios summarizes peer-reviewed research and clinical guidance in plain language.
        It is a companion to care — not a substitute for your doctor or care team.
      </p>
      <div class="site-footer__links">
        <a href={`${base}sourcing/`}>How we source information</a>
        <a href={`${base}about/`}>About Helios</a>
        <a href={editIssueUrl} target="_blank" rel="noopener noreferrer">
          See something outdated? Suggest an edit &#8599;
        </a>
      </div>
    </div>
    <p class="site-footer__legal">&copy; {new Date().getFullYear()} Helios.</p>
  </div>
</footer>
